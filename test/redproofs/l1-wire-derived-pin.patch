+package server
+
+import "nib/internal/discovery"
+
+// redProofWireDerivedPin is the negative fixture for L1 — nothing learned from the
+// network may influence WHICH peer is accepted. It takes a wire type and lets the
+// value reach a candidate's Fingerprint, which is the pin.
+//
+// It exists only inside a red proof's patch; it is never in the tree.
+func redProofWireDerivedPin(seen discovery.Seen) candidate {
+	return candidate{Fingerprint: []byte(seen.From.String())}
+}
