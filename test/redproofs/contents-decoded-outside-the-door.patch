+
+// recentFromPayload reads the recent-documents list out of a decrypted payload without
+// opening the vault. Convenience for the first-run wizard, which wants the list before the
+// key is chosen.
+func recentFromPayload(plain []byte) ([]string, error) {
+	var out Contents
+	if err := json.Unmarshal(plain, &out); err != nil {
+		return nil, err
+	}
+	return out.Recent, nil
+}
